  "characters": [
    {
      "id": "grandma",
      "name": "ย่ามะลิ",
      "portrait": "../../concepts/v2/living-grandma.jpg",
      "personality": "อบอุ่น ชอบเล่าเรื่องเก่า ไม่ขี้ลืมจนบดบังเบาะแส ผู้เปิดคดีและให้กำลังใจ ไม่ใช่ผู้ต้องสงสัย คำใบ้อ้อม"
    },
    {
      "id": "mek",
      "name": "ลุงเมฆ",
      "portrait": "../../concepts/v2/uncle-mek.jpg"
    },
    {
      "id": "rin",
      "name": "น้าริน",
      "portrait": "../../concepts/v2/rin.jpg",
      "look": "ผู้หญิงราว 35 ผมหางม้าต่ำสีดำ เสื้อเขียวอ่อน ผ้ากันเปื้อนสีเบจ ถือผ้าเช็ดโต๊ะ"
    }
  ],
  "dialogue": [
    {
      "id": "grandma-open",
      "speaker": "grandma",
      "text": "หลานมาแล้วเหรอจ๊ะ ย่าหาอัลบั้มรูปครอบครัวไม่เจอ ในนั้นมีรูปตาตอนหนุ่ม ๆ ด้วยนะ",
      "options": [
        {
          "label": "ถามเรื่องอัลบั้ม",
          "next": "grandma-ask"
        }
      ]
    },
    {
      "id": "grandma-ask",
      "speaker": "grandma",
      "text": "เมื่อเช้าย่ายังเห็นวางอยู่บนโต๊ะกลางเลย แต่บ่ายนี้น้ารินเข้ามาเก็บกวาดนะ"
    },
    {
      "id": "mek-1",
      "speaker": "mek",
      "text": "รินเอาอัลบั้มใส่กล่องที่ติดรูปดาว ลุงเห็นตอนเธอยกผ่านโต๊ะ แต่ไม่ได้มองว่าเอาไปวางที่ไหน",
      "options": [
        {
          "label": "ช่วยเติมครอสเวิร์ด (เสริม)",
          "next": "mek-2"
        }
      ]
    },
    {
      "id": "mek-2",
      "speaker": "mek",
      "text": "ถ้าชอบเกมคำศัพท์ มาช่วยลุงเติมหน้านี้ด้วยก็ได้นะ อีกไม่กี่คำเอง",
      "options": [
        {
          "label": "เปิดครอสเวิร์ด",
          "minigame": "crossword-mek"
        }
      ]
    },
    {
      "id": "mek-done",
      "speaker": "mek",
      "text": "ครบแล้ว! เดี๋ยวให้ทุกคนลองเล่นกัน ขอบใจมากนะ"
    },
    {
      "id": "note-text",
      "speaker": "note",
      "text": "ย่าคะ น้ำจากแจกันหกเปียกโต๊ะ หนูเลยย้ายอัลบั้มรูปไปเก็บก่อน กลัวเปียกค่ะ เก็บไว้ตามผังบ้านเดิมนะคะ — ริน"
    },
    {
      "id": "think-decoy-star",
      "speaker": "system",
      "text": "กล่องนี้มีรูปดาวก็จริง แต่อยู่ห้องนั่งเล่น ลองดูผังเก็บภาพว่ารูปถ่ายเก็บไว้ห้องไหนนะ"
    },
    {
      "id": "think-leaf",
      "speaker": "system",
      "text": "กล่องนี้ลายใบไม้ แต่ลุงเมฆเห็นกล่องที่มีรูปดาวนะ ลองหากล่องรูปดาวดู"
    },
    {
      "id": "grandma-locked",
      "speaker": "grandma",
      "text": "กล่องนี้ล็อกอยู่นะ ลองสรุปคดีบนกระดานให้ครบก่อนสิจ๊ะ",
      "status": "draft"
    },
    {
      "id": "album-found",
      "speaker": "grandma",
      "text": "เจอแล้ว! หน้าปกดอกไม้เล่มนี้เอง"
    },
    {
      "id": "reveal",
      "speaker": "grandma",
      "text": "นี่ไงรูปตา ขอบใจนะหลาน มานั่งดูด้วยกันมา ย่าจะเล่าให้ฟัง",
      "next": "rin-1"
    },
    {
      "id": "rin-1",
      "speaker": "rin",
      "text": "หาเจอแล้วใช่ไหม? เมื่อกี้น้ำหกบนโต๊ะ ฉันเลยรีบยกอัลบั้มใส่กล่อง แล้วทิ้งข้อความไว้",
      "next": "grandma-2"
    },
    {
      "id": "grandma-2",
      "speaker": "grandma",
      "text": "คราวหน้าช่วยเขียนด้วยนะว่าอยู่กล่องไหน วันนี้ทุกคนช่วยกันเป็นนักสืบเลย",
      "next": "rin-2"
    },
    {
      "id": "rin-2",
      "speaker": "rin",
      "text": "ได้เลย ครั้งหน้าเขียนให้ครบทั้งกล่องทั้งตำแหน่ง"
    },
    {
      "id": "postcard-text",
      "speaker": "postcard",
      "text": "ภาพที่เหลือฝากไว้ที่ห้องสมุดวันวาน — ลิ้นชักหมายเลข 7"
    }
  ],
