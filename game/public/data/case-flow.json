  "dialogues": [
    {
      "id": "a4c0e001-0000-4000-8000-00000000004a",
      "kind": "dialogue",
      "title": "ยายเปิดเรื่อง",
      "slug": "flow/dialogue/grandma-open",
      "who": "ยายมะลิ",
      "text": "หลานมาแล้วเหรอจ๊ะ ยายหาอัลบั้มรูปครอบครัวไม่เจอ ในนั้นมีรูปตาตอนหนุ่ม ๆ ด้วยนะ",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-000000000048",
          "kind": "choice",
          "title": "ถามเรื่องอัลบั้ม",
          "slug": "flow/dialogue/grandma-open/ask",
          "next": "flow/dialogue/grandma-ask"
        },
        {
          "id": "a4c0e001-0000-4000-8000-000000000049",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/grandma-open/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-00000000004c",
      "kind": "dialogue",
      "title": "ยายเล่าเรื่องอัลบั้ม",
      "slug": "flow/dialogue/grandma-ask",
      "who": "ยายมะลิ",
      "text": "เมื่อเช้ายายยังเห็นวางอยู่บนโต๊ะกลางเลย แต่บ่ายนี้น้ารินเข้ามาเก็บกวาดนะ",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-00000000004b",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/grandma-ask/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-00000000004e",
      "kind": "dialogue",
      "title": "ยายดีใจ",
      "slug": "flow/dialogue/grandma-win",
      "who": "ยายมะลิ",
      "text": "นี่ไงรูปตา ขอบใจนะหลาน มานั่งดูด้วยกันมา ยายจะเล่าให้ฟัง",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-00000000004d",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/grandma-win/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-000000000051",
      "kind": "dialogue",
      "title": "ลุงเมฆเล่า",
      "slug": "flow/dialogue/mek-open",
      "who": "ลุงเมฆ",
      "text": "รินเอาอัลบั้มใส่กล่องที่ติดรูปดาว ลุงเห็นตอนเธอยกผ่านโต๊ะ แต่ไม่ได้มองว่าเอาไปวางที่ไหน",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-00000000004f",
          "kind": "choice",
          "title": "ช่วยเติมครอสเวิร์ด (เสริม)",
          "slug": "flow/dialogue/mek-open/help",
          "next": "flow/dialogue/mek-crossword"
        },
        {
          "id": "a4c0e001-0000-4000-8000-000000000050",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/mek-open/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-000000000054",
      "kind": "dialogue",
      "title": "ลุงชวนเล่นครอสเวิร์ด",
      "slug": "flow/dialogue/mek-crossword",
      "who": "ลุงเมฆ",
      "text": "ถ้าชอบเกมคำศัพท์ มาช่วยลุงเติมหน้านี้ด้วยก็ได้นะ อีกไม่กี่คำเอง",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-000000000052",
          "kind": "choice",
          "title": "เปิดครอสเวิร์ด",
          "slug": "flow/dialogue/mek-crossword/play",
          "action": {
            "type": "minigame",
            "screen": "crossword"
          }
        },
        {
          "id": "a4c0e001-0000-4000-8000-000000000053",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/mek-crossword/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-000000000056",
      "kind": "dialogue",
      "title": "ลุงขอบคุณ",
      "slug": "flow/dialogue/mek-thanks",
      "who": "ลุงเมฆ",
      "text": "ครบแล้ว! เดี๋ยวให้ทุกคนลองเล่นกัน ขอบใจมากนะ",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-000000000055",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/mek-thanks/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-000000000058",
      "kind": "dialogue",
      "title": "เปิดอัลบั้ม",
      "slug": "flow/dialogue/album-open",
      "who": "ยายมะลิ",
      "text": "เจอแล้ว! หน้าปกดอกไม้เล่มนี้เอง",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-000000000057",
          "kind": "choice",
          "title": "ปิด",
          "slug": "flow/dialogue/album-open/close"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-00000000005a",
      "kind": "dialogue",
      "title": "รูปตา",
      "slug": "flow/dialogue/album-portrait",
      "who": "ยายมะลิ",
      "text": "นี่ไงรูปตา ขอบใจนะหลาน มานั่งดูด้วยกันมา ยายจะเล่าให้ฟัง",
      "choices": [
        {
          "id": "a4c0e001-0000-4000-8000-000000000059",
          "kind": "choice",
          "title": "ต่อ",
          "slug": "flow/dialogue/album-portrait/next",
          "next": "flow/dialogue/album-rin"
        }
      ]
    },
    {
      "id": "a4c0e001-0000-4000-8000-00000000005c",
      "kind": "dialogue",
      "title": "รินอธิบาย",
      "slug": "flow/dialogue/album-rin",
      "who": "ริน",
      "text": "หาเจอแล้วใช่ไหม? เมื่อกี้น้ำหกบนโต๊ะ ฉันเลยรีบยกอัลบั้มใส่กล่อง แล้วทิ้งข้อความไว้",
      "choices": [
